# Copiar a .env (nunca commitear valores reales). Las claves usan "__" como separador de secciones de appsettings.json.

# --- Entorno ---
# Development: SQLite local, Swagger en /swagger, admin de desarrollo y simulador de pagos.
# Production: Postgres, sin Swagger, falla al arrancar si falta configuracion.
ASPNETCORE_ENVIRONMENT=Production

# --- Base de datos ---
# Postgres (produccion): acepta la URL que da Supabase/Neon/Render o el formato Npgsql (Host=...;Username=...;Password=...;Database=...)
Database__Provider=Postgres
ConnectionStrings__Default=postgresql://usuario:clave@host:5432/birvenn
# Para probar sin instalar nada:
# Database__Provider=Sqlite
# ConnectionStrings__Default=Data Source=birvenn.db

# --- Sesion (JWT en cookie httpOnly) ---
# Minimo 32 caracteres. Generar una: openssl rand -base64 48
Jwt__Key=
# Lax si el front y la API comparten sitio (o el front proxea /api/*). None solo si estan en dominios distintos (exige HTTPS).
Jwt__CookieSameSite=Lax
Jwt__CookieSecure=true

# --- URLs ---
# Front publico (sin barra final). Se usa para las back_urls de Mercado Pago y para CORS.
Urls__Frontend=http://localhost:3000
# Esta API publicada con HTTPS: Mercado Pago llama aca al webhook.
Urls__PublicApi=http://localhost:5180
# Origenes permitidos por CORS, separados por coma.
Cors__Origins=http://localhost:3000
# true si hay un proxy delante que pone X-Forwarded-For (Render, Cloud Run, Nginx).
Network__TrustProxy=false

# --- Pagos ---
# Mock (aprueba al instante, solo desarrollo) o MercadoPago
Payments__Provider=Mock
# Access Token de la aplicacion (de prueba: TEST-...; de produccion: APP_USR-...)
MercadoPago__AccessToken=
# Clave secreta de Webhooks (Tus integraciones > Webhooks)
MercadoPago__WebhookSecret=

# --- Reglas comerciales (opcionales; valores por defecto en appsettings.json) ---
# Commerce__FreeShippingThreshold=150000
# Commerce__TransferDiscount=0.10
# Commerce__PendingExpirationHours=48
# Commerce__TransferInstructions=Alias: BIRVENN.PAGOS | CBU: ... | Titular: ...

# --- Usuario admin inicial (opcional). Se crea o se promueve al arrancar. ---
Admin__Email=
Admin__Password=

# --- Solo docker compose ---
# POSTGRES_PASSWORD=birvenn-local
