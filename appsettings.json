{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "AutoMigrate": true,
    "SeedCatalog": true
  },
  "Jwt": {
    "Issuer": "birvenn-api",
    "Audience": "birvenn-web",
    "CookieName": "birvenn_session",
    "SessionHours": 12,
    "RememberDays": 30,
    "CookieSameSite": "Lax",
    "CookieSecure": true
  },
  "Urls": {
    "Frontend": "http://localhost:3000",
    "PublicApi": "http://localhost:5180"
  },
  "Cors": {
    "Origins": "http://localhost:3000"
  },
  "Payments": {
    "Provider": "Mock",
    "AllowSimulation": false
  },
  "MercadoPago": {
    "BaseUrl": "https://api.mercadopago.com/",
    "StatementDescriptor": "BIRVENN",
    "UseSandboxInitPoint": false
  },
  "Commerce": {
    "Currency": "ARS",
    "FreeShippingThreshold": 150000,
    "Installments": 3,
    "TransferDiscount": 0.10,
    "WelcomeCouponPercent": 15,
    "WelcomeCouponDays": 30,
    "MaxQuantityPerItem": 10,
    "PendingExpirationHours": 48,
    "ExpirationIntervalSeconds": 300,
    "ClaimGuestOrdersByEmail": false,
    "TransferInstructions": "Te enviamos los datos bancarios por email. Tenés 48 h para transferir."
  },
  "RateLimit": {
    "AuthPerMinute": 10,
    "CheckoutPerMinute": 15,
    "PublicPerMinute": 60
  },
  "Network": {
    "TrustProxy": false
  },
  "Swagger": {
    "Enabled": false
  }
}
